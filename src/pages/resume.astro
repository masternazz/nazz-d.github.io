---
import BaseLayout from '../layouts/BaseLayout.astro';
import { profile } from '../data/portfolio';
---

<BaseLayout
  title="Resume | Nazeem Massoom Dickey"
  description="Resume for entry-level IT support, help desk, network support, and NOC opportunities."
>
  <main id="main" tabindex="-1">
    <header class="page-hero resume-page-hero">
      <div class="page-hero__side">
        <p class="eyebrow eyebrow--signal">Resume / Version 10</p>
        <p>Rebuilt after reviewing 10 public entry-level IT resumes and the feedback recruiters gave them.</p>
      </div>
      <h1>Proof first. One page.</h1>
    </header>

    <section class="resume-shell">
      <div class="resume-tools">
        <p>Single-column reading order, standard section labels, and a print layout sized for US Letter.</p>
        <div class="button-row">
          <a class="button button--signal" href="/Nazeem-Massoom-Dickey-Resume.pdf" download>Download PDF</a>
          <button class="button" type="button" id="print-resume">Print resume</button>
        </div>
      </div>

      <article class="resume-sheet">
        <header class="resume-head">
          <h2 class="resume-name">Nazeem Massoom Dickey</h2>
          <p class="resume-target">IT Support Specialist | Help Desk and Network Technician</p>
          <p class="resume-contact" aria-label="Contact information">
            <span>Boynton Beach, FL</span><span aria-hidden="true"> | </span>
            <a href={profile.phoneHref}>{profile.phone}</a><span aria-hidden="true"> | </span>
            <a href={'mailto:' + profile.email}>{profile.email}</a><span aria-hidden="true"> | </span>
            <a href={profile.linkedin}>linkedin.com/in/nazeemdickey</a><span aria-hidden="true"> | </span>
            <a href={profile.site}>masternazz.com</a>
          </p>
        </header>

        <section class="resume-summary">
          <h2>Professional Summary</h2>
          <p>
            IT support technician with two years of freelance help desk and desktop work (Windows, PC hardware,
            routers, DNS). CompTIA A+, Network+, Security+, and CySA+ certified. Built an Active Directory and GLPI
            ticketing lab; SkillsUSA Florida Internetworking gold medalist.
          </p>
        </section>

        <section class="resume-block resume-compact-block">
          <h2>Education and Certifications</h2>
          <div class="resume-compact-row">
            <h3>SouthTech Academy</h3>
            <p><strong>High School Diploma, May 2026</strong> | Boynton Beach, FL | Honor Roll and honors coursework</p>
          </div>
          <div class="resume-compact-row">
            <h3>Certifications</h3>
            <p>CompTIA A+, Network+, Security+, CySA+ (CIOS, CSIS, CSAP) | Cisco CCST IT Support, Networking, Cybersecurity | Microsoft AZ-900, SC-900, AI-900, DP-900, PL-900, AB-900 | EC-Council EHE, NDE</p>
          </div>
        </section>

        <section class="resume-block resume-skills-block">
          <h2>Technical Skills</h2>
          <dl class="resume-skills">
            <div><dt>Support</dt><dd>Help desk, desktop support, IT support, Windows 10/11, Microsoft 365, printers, PC hardware troubleshooting, ticketing (GLPI), user accounts and password resets, documentation</dd></div>
            <div><dt>Networking</dt><dd>Networking, TCP/IP, Ethernet, Wi-Fi, LAN, DNS, DHCP, VPN, routers, switches, firewalls, VLANs, routing (OSPF), Cisco IOS, NAT/PAT, ACLs</dd></div>
            <div><dt>Infrastructure</dt><dd>Windows Server, Active Directory, Microsoft Azure, Proxmox VE, OPNsense, Linux, Docker, OS installation</dd></div>
            <div><dt>Operations</dt><dd>Troubleshooting, data backup and recovery, monitoring, cybersecurity, recovery planning, change documentation</dd></div>
          </dl>
        </section>

        <section class="resume-block">
          <h2>Technical Experience</h2>
          <article class="resume-entry">
            <div class="resume-entry__head">
              <h3>Freelance IT Support Technician</h3>
              <time>Jun 2024 - Present</time>
            </div>
            <p class="resume-entry__meta">Self-employed | Boynton Beach, FL</p>
            <ul>
              <li>Configure home routers and resolve Wi-Fi, Ethernet, DNS, Windows, and PC hardware issues for 10+ local clients, then explain fixes in plain language.</li>
              <li>Supported Microsoft 365 accounts, printers, and data backups for clients.</li>
              <li>Restored expected download performance within five minutes by tracing a 100 Mbps negotiated Ethernet link to a faulty cable and validating its replacement.</li>
              <li>Returned a no-boot PC to service in about one minute by reseating moved memory in a supported paired configuration.</li>
              <li>Restored domain lookup and browsing within five minutes by separating DNS failure from general connectivity and switching to a working Cloudflare resolver.</li>
            </ul>
          </article>
        </section>

        <section class="resume-block">
          <h2>Selected Technical Projects</h2>
          <article class="resume-entry">
            <div class="resume-entry__head">
              <h3><a href="https://masternazz.com/work/operated-homelab">Segmented Three-node Homelab and VLAN Migration</a></h3>
              <time>2025 - Present</time>
            </div>
            <p class="resume-entry__meta">Proxmox VE | OPNsense | Cisco SG300 | Netgear managed switch | 802.1Q</p>
            <ul>
              <li>Operate a three-node Proxmox environment; moved a flat network into 10 role-based VLANs and migrated 20+ workloads, updating DHCP, DNS, and firewall rules.</li>
              <li>Installed a Cisco SG300 core and traced missing trunk VLANs to restore cluster quorum; repaired an OPNsense captive-portal binding and migrated client DNS to Technitium.</li>
            </ul>
          </article>

          <article class="resume-entry">
            <div class="resume-entry__head">
              <h3><a href="https://masternazz.com/work/active-directory-lab">Windows Active Directory and Ticketing Lab</a></h3>
              <time>2026</time>
            </div>
            <p class="resume-entry__meta">Windows Server 2025 | Active Directory | DNS | GLPI | LDAPS | PKI</p>
            <ul>
              <li>Built a Windows Server 2025 Active Directory domain (AD DS and DNS) in a home lab; practiced help-desk tasks including user and organizational-unit creation, password resets, and group management.</li>
              <li>Integrated a self-hosted GLPI ticketing system with the domain over encrypted LDAPS, secured by an Active Directory certificate authority, and worked sample tickets from intake to resolution.</li>
            </ul>
          </article>
        </section>

        <section class="resume-bottom-grid">
          <div class="resume-block resume-compact-block">
            <h2>Recognition</h2>
            <ul>
              <li><strong>1st Place</strong>, SkillsUSA Florida Internetworking, Apr 2026</li>
              <li>SkillsUSA NLSC National Competitor, Jun 2026</li>
              <li>CyberLaunch USF State Championship Qualifier</li>
            </ul>
          </div>
          <div class="resume-block resume-compact-block">
            <h2>Community Involvement</h2>
            <div class="resume-compact-row">
              <h3>Center for Child Counseling</h3>
              <div>
                <p>Community Event Volunteer | Jun 2024 - Jan 2026</p>
              </div>
            </div>
          </div>
        </section>
      </article>
    </section>
  </main>
  <script>
    document.querySelector('#print-resume')?.addEventListener('click', () => window.print());
  </script>
</BaseLayout>
